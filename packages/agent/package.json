{
  "name": "@remoteos/agent",
  "version": "0.1.0",
  "description": "RemoteOS Agent — daemon that runs on your computer and executes commands",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "remoteos-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@remoteos/shared": "workspace:*",
    "axios": "^1.7.0",
    "node-screenshots": "^0.2.0",
    "systeminformation": "^5.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
