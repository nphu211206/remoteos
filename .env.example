# ============================================================
# RemoteOS — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# --- AI Engine (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_LOG_LEVEL=info

# --- Database ---
# For development: leave empty (uses SQLite)
# For production: set PostgreSQL connection string
DATABASE_URL=

# --- Redis (optional for dev, required for prod) ---
REDIS_URL=

# --- Security ---
JWT_SECRET=change_this_to_a_random_string_in_production
DEVICE_REGISTRATION_CODE=your_secret_code_here

# --- Rate Limiting ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Agent ---
AGENT_POLL_INTERVAL_MS=2000
AGENT_HEARTBEAT_INTERVAL_MS=10000
AGENT_COMMAND_TIMEOUT_MS=30000
